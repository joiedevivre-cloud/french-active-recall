# Loaded automatically by Vite/Vitest when running `npm test` (mode "test").
# Dummy, non-secret values -- just enough so src/lib/supabase.ts doesn't
# throw on import in unit tests that transitively import it. No test in
# this suite makes a real network call.
VITE_SUPABASE_URL=https://test.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=test-key
